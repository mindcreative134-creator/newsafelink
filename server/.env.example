# Server Configuration
PORT=5000

# Blogger Blog Details
BLOGGER_BLOG_ID=5712128711812423984

# Blogger OAuth2 Credentials (Required for publishing posts to Blogger)
# Setup in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=

# Auto-sync Cron Schedule (Default: Every 2 hours)
# Format: minute hour day month day-of-week
CRON_SCHEDULE="0 */2 * * *"

# Set to true to automatically publish fetched items as draft or live posts
# If OAuth is not set, the server runs in Simulation / Test mode
AUTO_PUBLISH=true
